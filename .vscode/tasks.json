{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure (debug)",
            "type": "shell",
            "command": "cmake --preset debug",
            "problemMatcher": []
        },
        {
            "label": "CMake: build (debug)",
            "type": "shell",
            "command": "cmake --build --preset debug",
            "dependsOn": "CMake: configure (debug)",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CTest: run tests (debug)",
            "type": "shell",
            "command": "ctest --preset debug",
            "dependsOn": "CMake: build (debug)",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "CI: full check (format + ASan/UBSan + -Werror + clang-tidy)",
            "type": "shell",
            "command": "find include src tests -name '*.[ch]pp' | xargs clang-format --dry-run --Werror && cmake --workflow --preset ci",
            "problemMatcher": ["$gcc"]
        }
    ]
}
